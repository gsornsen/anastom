{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "anastom.dev/runtime-observation/v1alpha1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": { "type": { "const": "started" } }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "message"],
      "properties": {
        "type": { "const": "log" },
        "message": { "type": "string" },
        "droppedLogs": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "provider", "model"],
      "properties": {
        "type": { "const": "metadata" },
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "source": { "enum": ["configured", "reported"] },
        "runtimeVersion": { "type": "string" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "scope", "coverage"],
      "properties": {
        "type": { "const": "usage" },
        "scope": { "const": "attempt" },
        "coverage": { "enum": ["complete", "partial"] },
        "inputTokens": { "$ref": "#/definitions/counter" },
        "outputTokens": { "$ref": "#/definitions/counter" },
        "cacheReadTokens": { "$ref": "#/definitions/counter" },
        "cacheWriteTokens": { "$ref": "#/definitions/counter" },
        "reasoningTokens": { "$ref": "#/definitions/counter" },
        "totalTokens": { "$ref": "#/definitions/counter" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "status"],
      "properties": {
        "type": { "const": "completed" },
        "status": { "enum": ["succeeded", "failed", "blocked", "cancelled"] }
      }
    }
  ],
  "definitions": { "counter": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 } }
}
