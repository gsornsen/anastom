{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://anastom.dev/schemas/runtime-descriptor.v1alpha1.json",
  "title": "Anastom runtime descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "runtimeId", "configurationVersion", "configuration"],
  "properties": {
    "version": { "const": "anastom.dev/runtime-descriptor/v1alpha1" },
    "runtimeId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
    },
    "configurationVersion": { "type": "string", "minLength": 1, "maxLength": 256 },
    "configuration": { "type": "object" }
  }
}
