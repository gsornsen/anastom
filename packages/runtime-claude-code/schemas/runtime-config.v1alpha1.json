{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://anastom.dev/schemas/runtime-claude-code-config.v1alpha1.json",
  "title": "Anastom Claude Code runtime descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "runtimeId", "configurationVersion", "configuration"],
  "properties": {
    "version": { "const": "anastom.dev/runtime-descriptor/v1alpha1" },
    "runtimeId": { "const": "claude-code" },
    "configurationVersion": {
      "const": "anastom.dev/runtime-claude-code-config/v1alpha1"
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "authSource"],
      "properties": {
        "provider": { "const": "anthropic" },
        "model": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]{0,255}$"
        },
        "authSource": { "enum": ["subscription", "api-key"] }
      }
    }
  }
}
