{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://anastom.dev/schemas/sdlc-methodology-document.v1alpha1.json",
  "title": "Defined-SDLC methodology manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "roles"],
  "properties": {
    "apiVersion": { "const": "anastom.dev/v1alpha1" },
    "kind": { "const": "Methodology" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "const": "sdlc/default" },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
        }
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analyst",
        "planner",
        "implementer",
        "integrator",
        "specificationReviewer",
        "qualityReviewer"
      ],
      "properties": {
        "analyst": { "$ref": "#/$defs/readonlyRole" },
        "planner": { "$ref": "#/$defs/readonlyRole" },
        "implementer": { "$ref": "#/$defs/isolatedRole" },
        "integrator": { "$ref": "#/$defs/isolatedRole" },
        "specificationReviewer": { "$ref": "#/$defs/readonlyRole" },
        "qualityReviewer": { "$ref": "#/$defs/readonlyRole" }
      }
    }
  },
  "$defs": {
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prompt", "outputSchema", "mutation"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "outputSchema": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "mutation": { "enum": ["readonly", "isolated"] }
      }
    },
    "readonlyRole": {
      "allOf": [
        { "$ref": "#/$defs/role" },
        { "properties": { "mutation": { "const": "readonly" } } }
      ]
    },
    "isolatedRole": {
      "allOf": [
        { "$ref": "#/$defs/role" },
        { "properties": { "mutation": { "const": "isolated" } } }
      ]
    }
  }
}
