{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://anastom.dev/schemas/sdlc-graph-expansion.v1alpha1.json",
  "title": "Defined-SDLC graph expansion",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "source",
    "maxParallel",
    "externalNeeds",
    "nodeOrder",
    "nodes",
    "expansionDigest"
  ],
  "properties": {
    "apiVersion": { "const": "anastom.dev/v1alpha1" },
    "kind": { "const": "WorkflowExpansion" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["featureDigest", "methodologyDigest", "planDigest"],
      "properties": {
        "featureDigest": { "$ref": "#/$defs/digest" },
        "methodologyDigest": { "$ref": "#/$defs/digest" },
        "planDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "maxParallel": { "type": "integer", "minimum": 1, "maximum": 4 },
    "externalNeeds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "nodeOrder": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "nodes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "oneOf": [
          { "$ref": "#/$defs/agentNode" },
          { "$ref": "#/$defs/integrationNode" },
          { "$ref": "#/$defs/verifierNode" }
        ]
      }
    },
    "expansionDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,95}$" },
    "needs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "attemptBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxAttempts"],
      "properties": {
        "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 3 },
        "maxDurationMs": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "schema"],
      "properties": { "ref": { "type": "string", "minLength": 1 }, "schema": { "type": "object" } }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "cwd", "maxDurationMs", "maxOutputBytes"],
      "properties": {
        "argv": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "cwd": { "type": "string", "minLength": 1 },
        "maxDurationMs": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "maxOutputBytes": { "type": "integer", "minimum": 1, "maximum": 16777216 }
      }
    },
    "agentNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "needs",
        "role",
        "mutation",
        "mutationScopes",
        "attemptBudget",
        "instructions",
        "instructionsDigest",
        "output"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "agent" },
        "needs": { "$ref": "#/$defs/needs" },
        "role": { "type": "string", "minLength": 1 },
        "taskId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$" },
        "patchId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$" },
        "mutation": { "enum": ["readonly", "isolated"] },
        "mutationScopes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
        },
        "attemptBudget": { "$ref": "#/$defs/attemptBudget" },
        "instructions": { "type": "string", "minLength": 1, "maxLength": 131072 },
        "instructionsDigest": { "$ref": "#/$defs/digest" },
        "output": { "$ref": "#/$defs/output" }
      }
    },
    "integrationNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "needs", "mutation", "attemptBudget", "output", "controller"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "integration" },
        "needs": { "$ref": "#/$defs/needs" },
        "mutation": { "const": "isolated" },
        "attemptBudget": { "$ref": "#/$defs/attemptBudget" },
        "output": { "$ref": "#/$defs/output" },
        "controller": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation", "wave", "taskIds"],
          "properties": {
            "operation": { "const": "integrate-patches" },
            "wave": { "type": "integer", "minimum": 1, "maximum": 9 },
            "taskIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$" }
            }
          }
        }
      }
    },
    "verifierNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "needs", "mutation", "attemptBudget", "output", "command"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "verifier" },
        "needs": { "$ref": "#/$defs/needs" },
        "mutation": { "const": "readonly" },
        "attemptBudget": { "$ref": "#/$defs/attemptBudget" },
        "output": { "$ref": "#/$defs/output" },
        "command": { "$ref": "#/$defs/command" }
      }
    }
  }
}
