{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://anastom.dev/schemas/feature-plan.v1alpha1.json",
  "title": "Feature plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "tasks", "risks"],
  "properties": {
    "summary": { "type": "string", "minLength": 30, "maxLength": 4096 },
    "tasks": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "objective",
          "acceptanceCriteria",
          "dependsOn",
          "mutationScopes"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 160 },
          "objective": { "type": "string", "minLength": 20, "maxLength": 8192 },
          "acceptanceCriteria": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
          },
          "dependsOn": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 7,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$" }
          },
          "mutationScopes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "maxItems": 16,
      "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
    }
  }
}
