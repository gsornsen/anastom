{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://anastom.dev/methodologies/sdlc/default/analysis-report.v1alpha1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "boundaries", "risks"],
  "properties": {
    "summary": { "type": "string", "minLength": 30, "maxLength": 8192 },
    "boundaries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
    },
    "risks": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
    }
  }
}
